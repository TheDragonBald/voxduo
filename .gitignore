# Виртуальное окружение
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Сборка PyInstaller
build/
dist/

# Рабочие документы — локальные, в репозиторий не идут
PLAN.md
PLAN_CALIBRATION.md
CLAUDE.md

# Личные эталонные записи для замера качества
samples/*
!samples/.gitkeep

# Выгрузка `just export` — отладочная, точка истины это uv.lock
requirements-export.txt

# Временные файлы старой версии
temp_audio.wav

# Ярлыки Windows
*.lnk

# Локальные данные приложения (обычно в %LOCALAPPDATA%, но на всякий случай)
logs/
models/

# Фронтенд
node_modules/
*.tsbuildinfo
.vite/

# Личные настройки Claude Code и снимок состояния сессии
.claude/settings.local.json
.claude/session-state.md

# Личные переопределения git-хуков. Шаблон, а не одно имя: lefthook ищет
# локальный конфиг под несколькими — lefthook-local.yml, .lefthook-local.yml,
# плюс варианты с .yaml, — и строки под одно имя не хватило бы.
lefthook-local.*
.lefthook-local.*
